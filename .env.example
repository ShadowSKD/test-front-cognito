# AWS Cognito Configuration Example
# Replace these values with your actual AWS Cognito settings in your local .env file.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/YOUR_USER_POOL_ID
VITE_COGNITO_CLIENT_ID=YOUR_CLIENT_ID
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_LOGOUT_URI=http://localhost:5173
VITE_COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.us-east-1.amazoncognito.com
